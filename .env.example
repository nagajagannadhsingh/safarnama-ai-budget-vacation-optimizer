# GEMINI_API_KEY: Optional/Recommended for Gemini AI itinerary & review synthesis.
# If omitted or quota-limited, SAFARNAMA AI automatically runs in deterministic planning mode.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The public base URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: Server listening port (defaults to 3000 in dev, Cloud Run sets 8080)
PORT=3000

# NODE_ENV: Set to 'production' in live hosting environments
NODE_ENV=production
